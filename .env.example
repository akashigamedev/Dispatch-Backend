# Supabase (always required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Settings → Database → Connection string → URI (use "Transaction" pooler for serverless, "Session" for persistent server)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── GitHub auth ──────────────────────────────────────────────────────────────
# Set EITHER (1) GITHUB_PAT alone, OR (2) all five GITHUB_APP_* vars.
# If both are set, GitHub App takes precedence (PAT becomes fallback).

# (1) PAT mode — simplest, v1 default. Classic token with scopes: repo, read:org, project
GITHUB_PAT=

# (2) GitHub App mode — preferred when org admin approves the install
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Claude
# The server shells out to the `claude` CLI (Claude Code) and uses whatever
# credentials it finds — either an interactive login (`~/.claude/`) or a
# long-lived token in CLAUDE_CODE_OAUTH_TOKEN. No API key required.
# Generate the token once with: `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=

# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
