[Unit]
Description=Nightowl server
After=network.target

[Service]
Type=simple
User=nightowl
WorkingDirectory=/opt/nightowl
EnvironmentFile=/etc/nightowl/env
ExecStart=/usr/bin/node /opt/nightowl/dist/index.js
Restart=on-failure
RestartSec=5s
MemoryMax=900M
TasksMax=200

[Install]
WantedBy=multi-user.target
